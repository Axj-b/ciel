<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="SourceGit.Views.EditorPage"
             x:DataType="vm:EditorPage"
             x:Name="ThisControl">
  <Grid ColumnDefinitions="270,4,*">
    <!-- Working tree -->
    <Grid Grid.Column="0" RowDefinitions="Auto,*" Background="{DynamicResource Brush.SubPanel}">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="8,6,6,6">
        <TextBox Grid.Column="0"
                 Height="24"
                 BorderThickness="1"
                 CornerRadius="12"
                 Text="{Binding Filter, Mode=TwoWay}"
                 BorderBrush="{DynamicResource Brush.Border2}"
                 Watermark="{DynamicResource Text.Editor.Filter}"
                 VerticalContentAlignment="Center">
          <TextBox.InnerLeftContent>
            <Path Width="14" Height="14"
                  Margin="6,0,0,0"
                  Fill="{DynamicResource Brush.FG2}"
                  Data="{StaticResource Icons.Search}"/>
          </TextBox.InnerLeftContent>
        </TextBox>

        <Button Grid.Column="1"
                Classes="icon_button"
                Width="26" Height="24"
                Margin="4,0,0,0"
                Padding="0"
                Click="OnRefreshFiles"
                ToolTip.Tip="{DynamicResource Text.Editor.Refresh}">
          <Path Width="13" Height="13" Data="{StaticResource Icons.Reset}"/>
        </Button>
      </Grid>

      <Panel Grid.Row="1">
        <v:EditorFileTree/>
        <v:LoadingIcon Width="20" Height="20"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsRefreshingFiles}"/>
      </Panel>
    </Grid>

    <GridSplitter Grid.Column="1"
                  Width="4"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="Transparent"
                  Focusable="False"/>

    <!-- Open files -->
    <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,24">
      <Border Grid.Row="0"
              Background="{DynamicResource Brush.SubPanel}"
              BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource Brush.Border0}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ListBox ItemsSource="{Binding Tabs}"
                   SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                   Background="Transparent"
                   SelectionMode="Single"
                   Padding="0">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Margin" Value="4,2"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="BorderThickness" Value="1,0,0,0"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border0}"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:FileEditorTab">
                <StackPanel Orientation="Horizontal" Margin="8,0">
                  <Ellipse Width="6" Height="6"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           Fill="{DynamicResource Brush.Accent}"
                           IsVisible="{Binding IsDirty}"/>
                  <TextBlock Text="{Binding Name}"
                             VerticalAlignment="Center"
                             FontSize="11"
                             MaxWidth="200"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Path}"/>
                  <Button Classes="icon_button"
                          Width="16" Height="16"
                          Margin="6,0,0,0"
                          Padding="0"
                          VerticalAlignment="Center"
                          Click="OnCloseTab">
                    <Path Width="8" Height="8" Data="{StaticResource Icons.Close}"/>
                  </Button>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>
      </Border>

      <!-- Toolbar -->
      <Border Grid.Row="1"
              BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource Brush.Border0}"
              IsVisible="{Binding HasSelectedTab}">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" Height="30" Margin="4,0">
          <Button Grid.Column="0"
                  Classes="icon_button"
                  Width="26" Height="26"
                  Margin="0,2"
                  Padding="0"
                  Click="OnSave"
                  ToolTip.Tip="{DynamicResource Text.Editor.Save}">
            <Path Width="14" Height="14" Data="{StaticResource Icons.Save}"/>
          </Button>
          <Button Grid.Column="1"
                  Classes="icon_button"
                  Width="26" Height="26"
                  Margin="0,2"
                  Padding="0"
                  Click="OnReload"
                  ToolTip.Tip="{DynamicResource Text.Editor.Reload}">
            <Path Width="13" Height="13" Data="{StaticResource Icons.Reset}"/>
          </Button>
          <ToggleButton Grid.Column="2"
                        Classes="icon_button"
                        Width="26" Height="26"
                        Margin="0,2"
                        Padding="0"
                        IsChecked="{Binding IsWordWrapEnabled, Mode=TwoWay}"
                        ToolTip.Tip="{DynamicResource Text.Editor.WordWrap}">
            <Path Width="14" Height="14" Data="{StaticResource Icons.WordWrap}"/>
          </ToggleButton>
          <Button Grid.Column="3"
                  Classes="icon_button"
                  Width="26" Height="26"
                  Margin="0,2"
                  Padding="0"
                  Click="OnCycleViewMode"
                  IsVisible="{Binding IsSelectedTabMarkdown}"
                  ToolTip.Tip="{Binding ViewModeToolTip}">
            <Panel Width="14" Height="14">
              <Path Width="14" Height="14" Data="{StaticResource Icons.Code}" IsVisible="{Binding IsSourceMode}"/>
              <Path Width="14" Height="14" Data="{StaticResource Icons.SplitView}" IsVisible="{Binding IsSplitMode}"/>
              <Path Width="14" Height="14" Data="{StaticResource Icons.Edit}" IsVisible="{Binding IsInlineMode}"/>
              <Path Width="14" Height="14" Data="{StaticResource Icons.Eye}" IsVisible="{Binding IsRenderMode}"/>
            </Panel>
          </Button>

          <TextBlock Grid.Column="4"
                     Margin="8,0"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.FG2}"
                     FontSize="11"
                     Text="{Binding SelectedTab.Path}"
                     TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Border>

      <!-- Content -->
      <Panel x:Name="ContentArea" Grid.Row="2" Background="{DynamicResource Brush.Window}">
        <Grid x:Name="EditorPanel" IsVisible="{Binding HasSelectedTab}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <v:CodeEditor Grid.Column="0"
                        x:Name="Editor"
                        FontFamily="{DynamicResource Fonts.Monospace}"
                        FontSize="{Binding Source={x:Static vm:Preferences.Instance}, Path=EditorFontSize}"
                        TabWidth="{Binding Source={x:Static vm:Preferences.Instance}, Path=EditorTabWidth}"/>

          <GridSplitter Grid.Column="1"
                        x:Name="EditorSplitter"
                        Width="4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        Focusable="False"/>

          <v:MarkdownView Grid.Column="2"
                          x:Name="Preview"
                          IsVisible="False"/>
        </Grid>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    IsVisible="{Binding !HasSelectedTab}">
          <Path Width="48" Height="48"
                HorizontalAlignment="Center"
                Data="{StaticResource Icons.Edit}"
                Fill="{DynamicResource Brush.FG2}"/>
          <TextBlock HorizontalAlignment="Center"
                     Text="{DynamicResource Text.Editor.Empty}"
                     FontSize="16"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Brush.FG2}"/>
          <TextBlock HorizontalAlignment="Center"
                     Text="{DynamicResource Text.Editor.Empty.Hint}"
                     FontSize="11"
                     Foreground="{DynamicResource Brush.FG2}"/>
        </StackPanel>

        <!-- Rendered peek for the markdown block under the caret (Alt+F12) -->
        <Canvas x:Name="PeekLayer" IsVisible="False">
          <Border x:Name="PeekPanel" Classes="md_peek" Width="520">
            <Grid RowDefinitions="Auto,Auto">
              <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="10,5,6,4">
                <Path Width="12" Height="12"
                      VerticalAlignment="Center"
                      Data="{StaticResource Icons.Eye}"
                      Fill="{DynamicResource Brush.FG2}"/>
                <TextBlock Grid.Column="1"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Text="{DynamicResource Text.Markdown.Peek.Title}"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.FG2}"/>
                <Button Grid.Column="2"
                        Classes="icon_button"
                        Width="20" Height="20"
                        Padding="0"
                        Click="OnClosePeek"
                        ToolTip.Tip="{DynamicResource Text.Close}">
                  <Path Width="8" Height="8" Data="{StaticResource Icons.Close}"/>
                </Button>
              </Grid>
              <ScrollViewer Grid.Row="1"
                            x:Name="PeekScroll"
                            MaxHeight="260"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PeekContent" Margin="12,0,12,10"/>
              </ScrollViewer>
            </Grid>
          </Border>
        </Canvas>
      </Panel>

      <!-- Status bar -->
      <Border Grid.Row="3"
              Background="{DynamicResource Brush.SubPanel}"
              BorderThickness="0,1,0,0"
              BorderBrush="{DynamicResource Brush.Border0}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Margin="8,0"
                     VerticalAlignment="Center"
                     FontSize="11"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text="{Binding SelectedTab.MetaText}"/>
          <TextBlock Grid.Column="1"
                     Margin="8,0"
                     VerticalAlignment="Center"
                     FontSize="11"
                     FontWeight="Bold"
                     Foreground="DarkOrange"
                     Text="{DynamicResource Text.Editor.ReadOnly}"
                     IsVisible="{Binding IsSelectedTabReadOnly}"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
